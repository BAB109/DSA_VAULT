# ==============================================================================
# DSA Vault - Environment & Deployment Configuration
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real production credentials or secrets to source control.

# ── Application Environment ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database Configuration ───────────────────────────────────────────────────
# Preferred for managed cloud databases (Neon, Supabase, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql://username:password@ep-host.region.neon.tech/dsa_vault?sslmode=require

# Alternatively, configure discrete connection parameters:
PGHOST=localhost
PGPORT=5432
PGDATABASE=dsa_vault
PGUSER=postgres
PGPASSWORD=your_secure_db_password
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=false
PGMAX_CONNECTIONS=20

# Set to true in production if the server should fail readiness probes when DB is down:
REQUIRE_DB=false

# ── Authentication & Security Secrets ─────────────────────────────────────────
# Must be at least 32 random characters in production (e.g. generated via `openssl rand -hex 32`):
JWT_SECRET=generate_a_random_32_character_minimum_secret_key_here
JWT_EXPIRES_IN=7d

# ── CORS & Allowed Origins ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (leave unset in single-tier deploy):
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.com

# ── Frontend Configuration (Vite) ─────────────────────────────────────────────
# In development or single-tier deployment: default /api proxy is used.
# If hosting frontend separately on Vercel/Netlify/Cloudflare Pages, set full backend URL:
# VITE_API_URL=https://api.your-domain.com/api
